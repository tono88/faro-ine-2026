# Copie este archivo a .env y cambie los tres secretos. El archivo .env no se sube al repositorio.

# Clave de la base de datos.
POSTGRES_PASSWORD=cambie-esta-clave

# Clave de servicio para procesos automáticos (cabecera x-faro-token). Las personas entran con
# usuario y contraseña; el usuario inicial es admin / admin y debe cambiarse al primer ingreso.
FARO_TOKEN=cambie-esta-clave

# Secreto con el que se derivan las llaves de pareo (sustituyen al CUI). Si se cambia,
# las llaves nuevas dejan de coincidir con las anteriores. Guárdelo como una contraseña.
FARO_SAL=cambie-este-secreto-largo

# Cada cuántas horas se consulta el portal de datos abiertos del INE (0 = nunca).
FARO_SYNC_HORAS=24

# Puerto en esta máquina. Si está ocupado, cambie el número (iniciar.bat lo hace solo).
FARO_PUERTO=8082

# Por omisión el portal solo se atiende desde esta misma máquina (127.0.0.1). Para abrirlo a la red,
# póngalo detrás de un proxy con HTTPS y use:
# FARO_ESCUCHA=0.0.0.0
# FARO_HTTPS=1        # la galleta de sesión solo viaja cifrada

# Protección estadística: un conteo menor que este número no se muestra a quien no tiene sesión de
# analista o administrador. El valor lo fija el INE según su norma (0 = sin protección).
# FARO_UMBRAL_CELDA=3

# Trabajo de campo: servicios donde puede estar el formulario de la encuesta (separados por coma).
# FARO_FORMULARIOS=forms.office.com,forms.microsoft.com,forms.cloud.microsoft,forms.office365.us
# La posición del teléfono solo se entrega a páginas con HTTPS: para el trabajo de campo el portal
# debe publicarse con HTTPS (FARO_ESCUCHA y FARO_HTTPS, arriba).
