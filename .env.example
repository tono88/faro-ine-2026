# Copie este archivo a .env y cambie los tres secretos. El archivo .env no se sube al repositorio.

# Clave de la base de datos.
POSTGRES_PASSWORD=cambie-esta-clave

# Clave de servicio para procesos automáticos (cabecera x-faro-token). Las personas entran con
# usuario y contraseña; el usuario inicial es admin / admin y debe cambiarse al primer ingreso.
FARO_TOKEN=cambie-esta-clave

# Secreto con el que se derivan las llaves de pareo (sustituyen al CUI). Si se cambia,
# las llaves nuevas dejan de coincidir con las anteriores. Guárdelo como una contraseña.
FARO_SAL=cambie-este-secreto-largo

# Cada cuántas horas se consulta el portal de datos abiertos del INE (0 = nunca).
FARO_SYNC_HORAS=24

# Puerto en esta máquina. Si está ocupado, cambie el número (iniciar.bat lo hace solo).
FARO_PUERTO=8082
